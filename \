pipeline {
  agent any
  stages {
	stage('checkout') {
	  steps {
		git branch: 'main',
		  url: 'https://github.com/Ali2002Nazari/devops-ci-cd-project.git'
	  }
	}
	stage('Build Docker Image') {
	  steps {
		sh'''
		docker compose down || true
		docker rm -f flask-app || true
		docker compose up -d --build
		'''
	  }
	}
	stage('Health Check') {
	  steps {
		sh'''
		sleep 5
		curl -f http://localhost:5000/health
		'''
	  }
	}
  }
}
